{
  "appId": "cn.antigravity.workbuddytools",
  "productName": "WorkBuddy 自动化工具",
  "copyright": "Copyright © 2026",
  "directories": {
    "output": "release"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "dengwka",
      "repo": "workBuddyTools"
    }
  ],
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "electron/icons/icon.ico",
    "artifactName": "workbuddyTools-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "WorkBuddy 自动化工具",
    "artifactName": "workbuddyTools-Setup-${version}.${ext}",
    "deleteAppDataOnUninstall": false
  },
  "mac": {
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "icon": "electron/icons/icon.png",
    "category": "public.app-category.utilities",
    "artifactName": "workbuddyTools-${version}-${arch}.${ext}"
  },
  "dmg": {
    "artifactName": "workbuddyTools-${version}-${arch}.${ext}",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
