{
  "appId": "com.workbuddy.tools",
  "productName": "WorkBuddy 账号日常工具",
  "copyright": "Copyright © 2026 WorkBuddy Studio. All rights reserved.",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "icon": "electron/icons/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "artifactName": "workbuddyTools-${version}-win-${arch}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "WorkBuddy 账号日常工具",
    "installerIcon": "electron/icons/icon.ico",
    "uninstallerIcon": "electron/icons/icon.ico",
    "installerHeaderIcon": "electron/icons/icon.ico",
    "artifactName": "workbuddyTools-${version}-win-${arch}-setup.${ext}"
  },
  "portable": {
    "artifactName": "workbuddyTools-${version}-win-${arch}-portable.${ext}"
  },
  "mac": {
    "icon": "electron/icons/icon.png",
    "artifactName": "workbuddyTools-${version}-mac-${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.utilities",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "icon": "electron/icons/icon.png",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
