{
  "appId": "com.workbuddy.tools",
  "productName": "WorkBuddy 账号日常工具",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "artifactName": "workbuddyTools-${version}-win-${arch}-${target}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "WorkBuddy 账号日常工具",
    "artifactName": "workbuddyTools-${version}-win-${arch}-setup.${ext}"
  },
  "portable": {
    "artifactName": "workbuddyTools-${version}-win-${arch}-portable.${ext}"
  },
  "mac": {
    "artifactName": "workbuddyTools-${version}-mac-${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.utilities",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
